# ---------------------------------------------------------------------------
# KeyForge environment. Copy to .env.local and fill in. NEVER commit .env.local
# With ZERO variables set, the app still runs: it uses an in-memory mock store
# and a mock checkout so you can test the whole funnel locally for $0.
# ---------------------------------------------------------------------------

# Public base URL (used in checkout redirects + docs snippets)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- License key signing -----------------------------------------------------
# 32+ random bytes. Generate: openssl rand -hex 32
# If unset, a dev-only ephemeral secret is used (keys reset on server restart).
KEYFORGE_SIGNING_SECRET=

# --- Supabase (free tier) ----------------------------------------------------
# Project settings -> API. Service role key is SERVER-ONLY, never expose it.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Lemon Squeezy (primary monetization) ------------------------------------
# Store -> Settings -> API. Variant IDs come from each product's variant page.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_SOLO=
LEMONSQUEEZY_VARIANT_ID_STUDIO=
# Webhook signing secret you set when creating the webhook
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Optional crypto fallback (NOWPayments / USDT) ---------------------------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Owner access ------------------------------------------------------------
# Simple bearer token that unlocks the /dashboard admin views.
ADMIN_TOKEN=
